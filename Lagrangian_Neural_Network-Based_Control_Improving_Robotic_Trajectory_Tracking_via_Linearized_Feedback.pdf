            </rdf:Alt>
         </dc:description>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Lagrangian Neural Network-Based Control: Improving Robotic Trajectory Tracking via Linearized Feedback</rdf:li>
            </rdf:Alt>
         </dc:title>
